# PostgreSQL connection string from your database provider
DATABASE_URL=postgresql://username:password@host:5432/hearthline

# Set to false only when PostgreSQL does not require SSL locally
DATABASE_SSL=true

# Backend port
PORT=3000

# Optional frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Security and integrations
JWT_SECRET=replace-with-a-long-random-secret
API_KEY=replace-with-your-provider-api-key

# SMTP email automation
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=your-email@gmail.com
